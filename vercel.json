{
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/daily-export",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/daily-export?slot=pm",
      "schedule": "0 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "objectfirst.vercel.app"
        }
      ],
      "destination": "https://www.objectfirst.online/:path",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ebook.objectfirst.online"
        }
      ],
      "destination": "/scarica/",
      "permanent": false
    }
  ]
}
